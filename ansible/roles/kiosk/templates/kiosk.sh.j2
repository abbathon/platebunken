#!/bin/sh
# Managed by Ansible — platebunken/ansible/roles/kiosk. Hand edits will be overwritten.

# §4.3: the HOST owns blanking, not the app. xscreensaver was tried here and reverted the same
# day: a hard freeze, ~27s into a boot, with no kernel panic, no GPU error and no clean
# shutdown logged — correlated with xscreensaver's own session daemon, not proven against it,
# but there was no coredump tool installed to get further and this runs a child's device. Back
# to the plain xset blanking that had run for weeks without incident. Suspend at 30 minutes
# (platebunken-idle-watch.sh) is unaffected — nothing in the freeze implicated it.
xset s blank
xset s {{ kiosk_screensaver_seconds }}
xset dpms {{ kiosk_screensaver_seconds }} {{ kiosk_screensaver_seconds }} {{ kiosk_screensaver_seconds }}

# §10 says a Chromium crash is "~2 s black, then the crate". Make that literally true: a
# black root window means the gap shows nothing rather than a desktop he could poke at.
xsetroot -solid black

# There is no mouse in this product. Hide the pointer rather than leaving it parked on a sleeve.
unclutter -idle 0 -root &

# Chromium's "didn't shut down correctly" bar would sit over the crate after any power cut,
# and the flags that suppressed it were removed from source. Patch the profile instead.
PREFS="$HOME/.config/chromium/Default/Preferences"
if [ -f "$PREFS" ]; then
  sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$PREFS"
fi

# Wait for the server before opening the page.
#
# The page and the API come from the same origin (ARCHITECTURE.md §3.1), so if this laptop
# boots before platebunken-server answers — and it will: two machines, one power cut — then
# Chromium renders ITS OWN error page. White background, English text, a reload button: the
# child never sees an error, except at the exact moment he is most likely to be standing
# there. The app's own sleepy state cannot help, because the app has not loaded.
#
# So: black screen until the server answers, then open it. Silence is the right answer here
# the same way it is everywhere else in this product. Logged for whoever reads the journal.
wait_for_server() {
  i=0
  while ! curl -sf --max-time 2 "{{ kiosk_health_url }}" >/dev/null 2>&1; do
    i=$((i + 1))
    [ $((i % 15)) -eq 1 ] && echo "kiosk: waiting for {{ kiosk_health_url }} (${i})"
    sleep 2
  done
}

{% if kiosk_treat_as_secure_origin %}
# --unsafely-treat-insecure-origin-as-secure: ARCHITECTURE.md §3.1, the secure-origin trap.
#
# The server is on another host over plain http, so this origin is not "secure" and Chromium
# disables service workers and navigator.storage.persist() on it. Without those there is no
# persistent cover cache — and warm covers are the only thing standing between a held-down
# arrow key and a grid of black squares after a reboot. It also means the app shell itself can
# be cached, which is the other half of the wait_for_server problem above.
#
# This weakens a real browser protection, and it is the right call HERE and only here: one
# machine, one origin, one LAN, no WAN, no other site ever loaded. The portable answer is TLS
# in the stack; turn this off the day that exists.
SECURE_ORIGIN_FLAG='--unsafely-treat-insecure-origin-as-secure={{ kiosk_origin }}'
{% else %}
# kiosk_url is already https — real TLS, not this workaround. No flag needed.
SECURE_ORIGIN_FLAG=''
{% endif %}
# --password-store=basic: autologin never supplies a password, so PAM never unlocks the login
# keyring, and Chromium's default libsecret-backed store asks it to anyway on every start —
# an "Unlock Login Keyring" dialog nobody is there to answer, stealing input from the crate
# behind it. Nothing on this kiosk needs an encrypted password store; this tells Chromium to
# keep its own unencrypted one instead of asking gnome-keyring at all.

# Restart always, with no rate limit. systemd gives up after ~5 rapid restarts by default,
# which is the failure mode that looks like "the screen just went black and stayed black".
while true; do
  wait_for_server
  chromium \
    --kiosk \
    --app="{{ kiosk_url }}" \
    --start-fullscreen \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=OverscrollHistoryNavigation,TouchpadOverscrollHistoryNavigation,TranslateUI \
    --autoplay-policy=no-user-gesture-required \
    --check-for-update-interval=31536000 \
    --password-store=basic \
    $SECURE_ORIGIN_FLAG
  sleep 2
done
