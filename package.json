{
  "name": "platebunken",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.ts",
    "build": "vite build src/ui",
    "serve": "node --env-file=.env src/server/index.ts",
    "start": "node src/server/index.ts",
    "prototype": "node --env-file=.env scripts/dev.ts",
    "smoke": "node --env-file=.env scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "ma:user": "node --env-file=.env scripts/ma-user.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "db:seed": "node --env-file=.env src/cli.ts seed",
    "curate": "node --env-file=.env src/cli.ts curate",
    "pb": "node --env-file=.env src/cli.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@types/node": "^24.0.0"
  },
  "version": "0.4.0"
}
