# Environment-specific configuration — NEVER commit.
# Contains Home Assistant / Music Assistant entity IDs, tokens, IPs, room names.
.env
.env.*
!.env.example
config.local.*
secrets.*

# Local state
*.sqlite
*.sqlite3
*.db
data/
cache/
covers/

# Deps / build
node_modules/
dist/
build/
.venv/
__pycache__/
*.pyc

# OS / editor
.DS_Store
.idea/
*.swp

# Local harness state — embeds absolute home paths
.claude/settings.local.json
.impeccable/config.local.json

# A dump of a private music library — never commit.
#
# Nothing produces this any more: scripts/snapshot.ts was deleted once the page started
# reading the approved set from the store. The rule stays as a guard, because the file used to
# land in the page's public/ directory, which the build copies wholesale — one ignore line was
# all that stood between a private library dump and a published image.
src/ui/public/library.json
src/ui/public/library.json

# Ansible inventory and vars — hostname, address, SSID, PSK. Never commit.
ansible/inventory.yml
ansible/group_vars/kiosk.yml
ansible/*.retry

# Site-specific secret-scan patterns. NEVER commit: the strings most worth catching are
# the ones that must not appear in a public repository. See scripts/scan-secrets.sh.
.secret-patterns.local
